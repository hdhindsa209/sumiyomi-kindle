            400: {
                perView: 2,
            }
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        new Glide('.glide', glide_config).mount()
    })

    function clearRecommendationSearchModal() {
        const recommendationSearchInput = document.getElementById("recommendation-search-input");
        if (recommendationSearchInput) {
            recommendationSearchInput.value = ""
        }

        const recommendationSearchResult = document.getElementById("recommendation-search-result");
        if (recommendationSearchResult) {
            recommendationSearchResult.innerHTML = ""
        }
    }

    function checkNewChapter(isoDateTime) {
        const diffInHours = (new Date() - new Date(isoDateTime)) / (1000 * 60 * 60)
        return diffInHours < 24 && diffInHours >= 0
    }

    function selectAllChapters() {
        const checkboxes = document.querySelectorAll('#chapter-list input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            checkbox.checked = true;
        });
    }

    function unselectAllChapters() {
        const checkboxes = document.querySelectorAll('#chapter-list input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            checkbox.checked = false;
        });
    }

    function recommendationFocus() {
        const recommendationSearchInput = document.getElementById("recommendation-search-input");
        if (recommendationSearchInput) {
            setTimeout(() => {
                recommendationSearchInput.focus();
            }, 10);
        }
    }

</script>


