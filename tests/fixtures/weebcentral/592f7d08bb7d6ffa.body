                                        <circle class="icon-eye hidden" cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </label>
                            </div>
                            <div class="validator-hint hidden">Must be 8 to 128 characters</div>
                        </fieldset>
                    </form>
                    <div id="register-message" class="hidden"></div>
                    <button type="submit" form="register-form" class="btn btn-primary">Register</button>
                </div>
                <div class="flex flex-col gap-6" x-show="forget_password">
