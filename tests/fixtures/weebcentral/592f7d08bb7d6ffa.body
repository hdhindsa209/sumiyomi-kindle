                        </fieldset>
                    </form>
                    <div id="login-message" class="hidden"></div>
                    <div class="flex gap-6">
                        <button type="button" class="flex-1 btn btn-primary" hx-post="/auth/quick-login" hx-target="#login-message" hx-target-401="#login-message" hx-swap="outerHTML" hx-on:htmx:after-request="if(event.detail.xhr.status === 200) clearCacheLogInOut()">Quick Login</button>
                        <button type="submit" form="login-form" class="flex-1 btn btn-primary">Login</button>
                    </div>
                </div>
                <div class="flex flex-col gap-6" x-show="register">
                    <form id="register-form" class="flex flex-col gap-6" hx-post="/auth/register" hx-target="#register-message" hx-include="#visitor-id" hx-target-400="#register-message" hx-swap="outerHTML" hx-on:htmx:after-request="if(event.detail.xhr.status === 200) clearCacheLogInOut()">
                        <fieldset class="fieldset text-base">
                            <legend class="fieldset-legend">Email</legend>
                            <input type="email" class="input validator w-full" id="register-email" name="email" autocomplete="email" placeholder="you@example.com" required>
                            <div class="validator-hint hidden">Enter valid email address</div>
                        </fieldset>
                        <fieldset class="fieldset text-base">
                            <legend class="fieldset-legend">Username</legend>
                            <input type="input" class="input validator w-full" id="register-username" name="username" pattern="[A-Za-z][A-Za-z0-9_\-]*" minlength="3" maxlength="25" placeholder="Username" title="Only letters, numbers, dash, and underscore" required>
                            <div class="validator-hint hidden">
                                Must be 3 to 25 characters
                                <br />containing only letters, numbers, dash, and underscore
                            </div>
                        </fieldset>
                        <fieldset class="fieldset text-base">
                            <legend class="fieldset-legend">Password</legend>
                            <div class="input validator w-full">
                                <input type="password" class="password-input" id="register-password" autocomplete="current-password" name="password" minlength="8" maxlength="128" placeholder="********" required />
                                <label class="cursor-pointer">
                                    <input class="password-toggle sr-only" type="checkbox" />
                                    <svg class="w-4 h-4 cursor-pointer shrink-0 size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path class="icon-eye-off" d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                                        <path class="icon-eye-off" d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                                        <path class="icon-eye-off" d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                                        <line class="icon-eye-off" x1="2" x2="22" y1="2" y2="22"></line>
