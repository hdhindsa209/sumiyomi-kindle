                    </button>
                </li>
            </ul>
            <div class="mt-4" hx-ext="response-targets">
                <div class="flex flex-col gap-6" x-show="login">
                    <form id="login-form" class="flex flex-col gap-6" hx-post="/auth/login" hx-target="#login-message" hx-include="#visitor-id" hx-target-400="#login-message" hx-swap="outerHTML" hx-on:htmx:after-request="if(event.detail.xhr.status === 200) clearCacheLogInOut()">
                        <fieldset class="fieldset text-base">
                            <legend class="fieldset-legend">Email</legend>
                            <input type="email" class="input validator w-full" id="login-email" name="email" autocomplete="email" placeholder="you@example.com" required>
                            <div class="validator-hint hidden">Enter valid email address</div>
                        </fieldset>
                        <fieldset class="fieldset text-base">
                            <legend class="fieldset-legend">Password</legend>
                            <div class="input validator w-full">
                                <input type="password" class="password-input" id="login-password" autocomplete="current-password" name="password" minlength="8" maxlength="128" placeholder="********" required />
                                <label class="cursor-pointer">
                                    <input class="password-toggle sr-only" type="checkbox" />
