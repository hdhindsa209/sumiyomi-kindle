<main class="bg-base-100 flex-1 flex flex-col items-center py-4 px-0 md:px-4" hx-ext="response-targets">
    <div id="top" class="bg-base-200 max-w-7xl w-full flex-1 flex flex-col gap-4 p-6">
        <!-- SERIES INFO -->
        <section class="flex flex-col md:flex-row gap-4 md:gap-8" x-data="{ show_detail: false, subscriptions: 822, last_read_chapter: '' }">
            <!-- LEFT -->
            <section class="md:w-4/12 flex flex-col gap-4">
                <h1 class="md:hidden text-2xl font-bold text-center">Nee-chan no Tomodachi ga Uzai Hanashi</h1>
                <section class="md:hidden flex flex-col items-center justify-center">
                    <div class="flex join bg-gray-200 border-4 border-gray-200">
                        <div class="bg-gray-200 border-r border-gray-200 text-black flex items-center justify-center join-item px-5" x-text="new Intl.NumberFormat('en-US').format(subscriptions)"></div>
                        
                        <button class="btn bg-red-600 hover:bg-red-400 border-none text-white join-item w-32 cursor-pointer" id="left-sub-button" x-on:htmx:after-request="if(event.detail.successful) subscriptions++" hx-post="https://weebcentral.com/series/01KTEH8Z2TJ9NQ2NDZ75EM36SS/subscribe">
                            Subscribe
                        </button>
                        
                    </div>
                </section>
