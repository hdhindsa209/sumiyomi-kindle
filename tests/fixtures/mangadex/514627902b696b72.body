ype":"cover_art","attributes":{"description":"","volume":"0.1","fileName":"6f2b8615-e93d-4352-866b-04ed7dd831c1.jpg","locale":"ja","createdAt":"2026-06-26T06:53:35+00:00","updatedAt":"2026-06-29T03:42:13+00:00","version":2}},{"id":"5de2ec81-8b9d-4698-b5d3-b953d8455ec7","type":"creator"}]},{"id":"0cf91ce5-5033-4fce-8687-b14c6a4d10b6","type":"manga","attributes":{"title":{"ja-ro":"Hone Dragon no Mana Musume"},"altTitles":[{"ja":"\u9aa8\u30c9\u30e9\u30b4\u30f3\u306e\u30de\u30ca\u5a18"},{"en":"The Skull Dragon's Precious Daughter"},{"en":"The Bone Dragon's Beloved Daughter"},{"id":"Putri Semata Wayang Naga Balung"},{"ru":"\u041d\u0435\u043d\u0430\u0433\u043b\u044f\u0434\u043d\u0430\u044f \u0434\u043e\u0447\u044c \u043a\u043e\u0441\u0442\u044f\u043d\u043e\u0433\u043e \u0434\u0440\u0430\u043a\u043e\u043d\u0430"},{"fr":"L'Enfant du Dragon fant\u00f4me"}],"description":{"en":"A trash can forest where everything is thrown away. Eve, a young girl who was dropped there, is picked up and raised by an old dragon who is about to die. Under the patronage of an old dragon named Nem, Eve grows up healthy, but the peaceful days are a moment of sad farewell. However, Eve takes a surprising action \u2026? An old dragon and a girl, a fantasy of raising parents and children beyond species!","ja":"\u8001\u30c9\u30e9\u30b4\u30f3\u3068\u5c11\u5973\u3001\u7a2e\u3092\u8d85\u3048\u305f\u89aa\u5b50\u306e\u6210\u308a\u4e0a\u304c\u308a\u80b2\u6210\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\uff01"},"isLocked":false,"links":{"al":"127910","ap":"the-skull-dragons-precious-daughter","bl":"931491","bw":"series\/294789\/list","kt":"60667","mu":"xltdexr","amz":"https:\/\/www.amazon.co.jp\/dp\/B0FCVDK383","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/631893","mal":"137306","raw":"https:\/\/magcomi.com\/episode\/13933686331710231382","engtl":"https:\/\/sevenseasentertainment.com\/series\/the-skull-dragons-precious-daughter"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2020,"contentRating":"safe","tags":[{"id":"36fd93ea-e8b8-445e-b836-358f02b3d33d","type":"tag","attributes":{"name":{"en":"Monsters"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-12-20T21:01:41+00:00","updatedAt":"2026-05-05T12:59:24+00:00","version":27,"availableTranslatedLanguages":["id","es-la","en","ru","pt-br","th"],"latestUploadedChapter":"ce42c802-30d3-4d9c-8bd3-1128c115b906"},"relationships":[{"id":"26888bb2-00b8-4cc3-9896-761f40f85028","type":"author"},{"id":"26888bb2-00b8-4cc3-9896-761f40f85028","type":"artist"},{"id":"ceee9c4e-b777-44b1-9614-6e2644cc5c57","type":"cover_art","attributes":{"description":"","volume":"6","fileName":"11ab00de-9b0e-4a13-aa11-096ee6b8695a.jpg","locale":"ja","createdAt":"2025-08-03T16:18:20+00:00","updatedAt":"2025-08-03T16:18:20+00:00","version":1}}]},{"id":"a990dd6e-7049-4fe0-a281-3909b2498086","type":"manga","attributes":{"title":{"ja-ro":"Oosaki-san to Komori-san"},"altTitles":[{"ja":"\u5927\u5d0e\u3055\u3093\u3068\u5c0f\u68ee\u3055\u3093"},{"en":"Oosaki-san & Komori-san"},{"pt-br":"Oosaki-san e Komori-san"}],"description":{"en":"The huge, poker-faced Oosaki-san is intimidating at first glance, but she's actually gentle and shy. Joining her at work is the new part-timer, the petite and friendly 147cm Komori-san.\nDespite their appearances and personalities being total opposites, they find themselves drawn to one another without even realizing...!\nThe awkward crybaby Oosaki-san is a carnivore of love, whereas the oblivious easy-going Komori-san is a total herbivore.\n\nWhat lies in store on the path of love for this mismatched pair with a 50 centimeter height gap...?","pt-br":"A enorme e impass\u00edvel Oosaki-san pode parecer intimidadora \u00e0 primeira vista, mas na verdade ela \u00e9 gentil e t\u00edmida. Juntando-se a ela no trabalho est\u00e1 a nova funcion\u00e1ria de meio per\u00edodo, a pequena e simp\u00e1tica Komori-san, de 147 cm.\nApesar de suas apar\u00eancias e personalidades serem totalmente opostas, elas se veem atra\u00eddas uma pela outra sem nem perceberem...!\nA desajeitada e chorona Oosaki-san \u00e9 uma carn\u00edvora do amor, enquanto a despreocupada e tranquila Komori-san \u00e9 uma herb\u00edvora completa.\nO que o futuro reserva para esse par improv\u00e1vel com uma diferen\u00e7a de altura de 50 cent\u00edmetros?"},"isLocked":false,"links":{"al":"212102","ap":"oosaki-san-to-komori-san","bl":"20180459","kt":"oosaki-san-to-komori-san","mu":"7ofoi9o","mal":"193326"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":null,"status":"ongoing","year":2025,"contentRating":"safe","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a3c67850-4684-404e-9b7f-c69850ee5da6","type":"tag","attributes":{"name":{"en":"Girls' Love"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b11fda93-8f1d-4bef-b2ed-8803d3733170","type":"tag","att