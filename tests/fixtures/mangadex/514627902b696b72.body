ersion":1},"relationships":[]},{"id":"ee968100-4191-4968-93d3-f82d72be7e46","type":"tag","attributes":{"name":{"en":"Mystery"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2019-07-16T15:13:54+00:00","updatedAt":"2025-11-15T21:27:46+00:00","version":5,"availableTranslatedLanguages":["en","ru"],"latestUploadedChapter":"d45c640d-0dbe-42ea-a00e-8c3172ecebfd"},"relationships":[{"id":"76c9a186-d0fa-4d54-802e-a603283eb2b4","type":"author"},{"id":"98b4d512-6b20-490d-ab05-4bc47dcd87a2","type":"author"},{"id":"95ffdb5c-a89f-45a2-81fa-e161e320a15a","type":"artist"},{"id":"75b91bd6-3847-4fa8-ad22-5adccb439200","type":"cover_art","attributes":{"description":"","volume":null,"fileName":"bdec893c-d28e-4161-9dee-1eeafa6058b5.jpg","locale":"ja","createdAt":"2021-05-24T17:19:12+00:00","updatedAt":"2021-05-24T17:19:12+00:00","version":1}},{"id":"5e027a8d-1543-4ec4-acb2-ebfc73538047","type":"manga","related":"sequel"},{"id":"5f518b39-298d-430c-89ae-963aba99928d","type":"manga","related":"same_franchise"}]},{"id":"4911120a-723f-4c36-af98-00dc2b7b2f76","type":"manga","attributes":{"title":{"ja-ro":"Tensei Teido de Mune no Ana wa Umaranai"},"altTitles":[{"ja":"\u8ee2\u751f\u7a0b\u5ea6\u3067\u80f8\u306e\u7a74\u306f\u57cb\u307e\u3089\u306a\u3044"},{"en":"The Hole in My Heart Cannot Be Filled with Reincarnation"},{"en":"The Hole in My Heart Cannot Be Filled Merely by Reincarnating"},{"en":"Reincarnation Isn\u2019t Enough to Fill the Hole in My Heart"}],"description":{"en":"In this other world, a person's deepest longing becomes their unique magic.\n\nAdepts - transcendent beings who wield unique magic and guard humanity from the Evil Gods, are granted every conceivable right.\n\nKonoe's past life was nothing but loneliness. So this time, he wished with everything he had, \u201cI want to be someone's most important person.\u201d And to make that wish come true, he went through years of brutal training, finally earning the title of Adept, all to attain the right to use forbidden love potions.\n\nThe one who came seeking his help was a golden-haired girl afflicted with a terminal plague.\n___\n**Character Designer:** [Isshiki](https:\/\/mangadex.org\/author\/14c2409b-3317-40d7-b51d-34f7e130b5b4)","ja":"\u4eba\u306e\u6e07\u671b\u3008\u306d\u304c\u3044\u3009\u304c\u56fa\u6709\u306e\u9b54\u6cd5\u306b\u306a\u308b\u7570\u4e16\u754c\u3002\n\u56fa\u6709\u9b54\u6cd5\u3092\u6271\u3044\u90aa\u795e\u304b\u3089\u4eba\u985e\u3092\u5b88\u8b77\u3059\u308b\u8d85\u8d8a\u8005\u3008\u30a2\u30c7\u30d7\u30c8\u3009\u305f\u3061\u306b\u306f\u3001\u3042\u3089\u3086\u308b\u6a29\u5229\u304c\u4e0e\u3048\u3089\u308c\u308b\u3002\n\u5b64\u72ec\u306b\u82e6\u3057\u3093\u3060\u524d\u4e16\u306e\u7d4c\u9a13\u304b\u3089\u3001\u300c\u8ab0\u304b\u306e\u4e00\u756a\u306b\u306a\u308a\u305f\u3044\u300d\u305d\u3046\u5f37\u304f\u9858\u3063\u305f\u30b3\u30ce\u30a8\u306f\u3001\u7981\u6b62\u85ac\u7269\u3067\u3042\u308b\u60da\u308c\u85ac\u3092\u4f7f\u3046\u305f\u3081\u306b\u3001\u6c38\u3044\u4fee\u884c\u306e\u672b\u9042\u306b\u305d\u306e\u8cc7\u683c\u3092\u5f97\u305f\u3002\n\n\u305d\u3093\u306a\u5f7c\u306b\u52a9\u3051\u3092\u6c42\u3081\u3066\u304d\u305f\u306e\u306f\u3001\u6b7b\u75c5\u306b\u4fb5\u3055\u308c\u305f\u91d1\u8272\u306e\u5c11\u5973\u3067\u2015\u2015\u3002"},"isLocked":false,"links":{"al":"213894","mu":"qhs7bi9","nu":"something-as-simple-as-reincarnation-cant-fill-the-hole-in-my-heart","mal":"194420","raw":"https:\/\/comic-walker.com\/detail\/KC_017970_S?episodeType=first"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2026,"contentRating":"safe","tags":[{"id":"0bc90acb-ccc1-44ca-a34a-b9f3a73259d0","type":"tag","attributes":{"name":{"en":"Reincarnation"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"}