8-ad417a66b617","type":"artist"},{"id":"c237b824-0d84-4531-b0cb-e19e8a118e31","type":"artist"},{"id":"c2d6fe7c-59e6-416f-b58a-fecb55a77b01","type":"artist"},{"id":"c519ab51-9a04-4d12-8239-b4f07de794c0","type":"artist"},{"id":"d0d4c0a5-18ee-48f5-94a5-4744a77eb4ee","type":"artist"},{"id":"d6f3826b-bcbd-4400-9ee7-f961f16f0f9f","type":"artist"},{"id":"dc3c344c-7cd3-43dd-a3b0-0bbcb0f33f66","type":"artist"},{"id":"dc6a6042-9792-465b-9385-4ef6cffa8c74","type":"artist"},{"id":"e342c215-ca40-45f7-9ecf-0062c9fdbc08","type":"artist"},{"id":"e4c482a4-465f-4aa7-a8f9-b13577534b06","type":"artist"},{"id":"f7b35bba-b756-4f69-a543-c53c0a3367ec","type":"artist"},{"id":"fee025e9-c96f-4f50-b8ba-38252f393716","type":"cover_art","attributes":{"description":"","volume":"3","fileName":"1254ffef-1a5d-4789-9a66-bf148ac3e93e.jpg","locale":"ja","createdAt":"2024-06-13T10:17:59+00:00","updatedAt":"2024-06-13T10:17:59+00:00","version":1}},{"id":"b8aca429-abdb-4213-906f-2fec83c385f3","type":"manga","related":"serialization"},{"id":"6d27972a-5468-4980-9681-18fa1c33dced","type":"creator"}]},{"id":"a3ebdf54-8715-4bd8-a1cf-fb0c3cc3d849","type":"manga","attributes":{"title":{"en":"An Evil Dragon That Was Sealed Away for 300 Years Became My Friend (Pre-Serialization)"},"altTitles":[{"ja-ro":"300-Nen F\u016bin sa reshi Jaryuu-chan to Tomodachi ni Narimashita"},{"ja":"300\u5e74\u5c01\u5370\u3055\u308c\u3057\u90aa\u9f8d\u3061\u3083\u3093\u3068\u53cb\u9054\u306b\u306a\u308a\u307e\u3057\u305f"},{"es":"Sellada por 300 a\u00f1os y me volv\u00ed el amigo de una drag\u00f3n malvada"},{"es":"Una drag\u00f3n que fue sellada por 300 a\u00f1os se volvi\u00f3 mi amiga"},{"ru":"\u0417\u043b\u043e\u0439 \u0434\u0440\u0430\u043a\u043e\u043d, \u0437\u0430\u043f\u0435\u0447\u0430\u0442\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 300 \u043b\u0435\u0442, \u0441\u0442\u0430\u043b \u043c\u043e\u0438\u043c \u0434\u0440\u0443\u0433\u043e\u043c"},{"es-la":"Una dragona malvada que fue sellada durante 300 a\u00f1os se vuelve mi amiga (Pre-serializaci\u00f3n)"}],"description":{"en":"Youta wanted a friend, so *obviously*, he magically summoned one.\n\nHe didn't quite count with the fact that he'd summon Mumu, a mighty and evil dragon girl, notwithstanding that due to hundreds of years of imprisonment, she's **very** needy, **very** weepy, **very** clingy, and lonelier than the button \"9\" on a microwave oven.\n\n[A serialization now exists](https:\/\/mangadex.org\/title\/ff09caa3-a990-4dff-a22f-d33d9be38f1c\/300-nen-fuuinsareshi-jaryuu-chan-to-tomodachi-ni-narimashita), though the chapter numbering is not straightforward.\n\n\n\n---\nTwitter raws can be found in the URL below. Pixiv raws (which update after the Twitter release) can be found [here](https:\/\/www.pixiv.net\/user\/13651304\/series\/70185).\n\nBuy the book here:\n[Melonbooks](https:\/\/www.melonbooks.co.jp\/detail\/detail.php?product_id=699033)\n[Toranoana](https:\/\/ecs.toranoana.jp\/tora\/ec\/item\/040030845366\/)","es":"Youta quer\u00eda una amistad, as\u00ed que *obviamente* us\u00f3 magia para conjurar a una.  \n  \nNo cont\u00f3 con el hecho de que conjurar\u00eda a Mumu, una poderosa y malvada ni\u00f1a drag\u00f3n, no obstante que debido a cientos de a\u00f1os de aprisionamiento ella es **muy** necesitada, **muy** llorona, **muy** pegote, y mas solitaria que el bot\u00f3n \"9\" de un horno microondas."},"isLocked":false,"links":{"kt":"56303","mu":"u4qwmn5"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"1","lastChapter":"13","publicationDemographic":null,"status":"completed","year":null,"contentRating":"safe","tags":[{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"dd1f77c5-dea9-4e2b-97ae-224af09caf99","type":"tag","attributes":{"name":{"en":"Monster Girls"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e197df38-d0e7-43b5-9b09-2842d0c326dd","type":"tag","attributes":{"name":{"en":"Web Comic"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-04-21T18:26:20+00:00","updatedAt":"2025-11-15T17:10:36+00:00","version":20,"availableTranslatedLanguages":["en","es-la","id","fr","uk"],"latestUploadedChapter":"5a9ac266-68b1-48a1-8539-bfecc3e4b0ba"},"relationships":[{"id":"16f4a4f1-0613-4ee8-91d0-e58b90622d29","type":"author"},{"id":"16f4a4f1-0613-4ee8-91d0-e58b90622d29","type":"artist"},{"id":"dd3f407b-ec53-4fd1-8d6b-f78cbbcd7e78","type":"cover_art","attributes":{"description":"","volume":null,"fileName":"285e1909-f5af-4290-9bd8-cef3acdc5b82.jpg","locale":"ja","createdAt":"2021-05-24T17:53:16+00:00","updatedAt":"2021-05-24T17:53:16+00:00","version":1}},{"id":"a9a309ea-7711-4c3d-af13-2bfa54cd31be","type":"manga","related":"alternate_story"},{"id":"ff09caa3-a990-4dff-a22f-d33d9be38f1c","type":"manga","related":"serialization"}]}],"limit":20,"offset":0,"total":22}